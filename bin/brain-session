#!/bin/sh
# SessionStart hook — ① look for the events that need indexing work and, only then, start the one shared worker
# (§deferred.on_session_start: a session start never indexes by itself) ② notify if the last session ended with
# nothing remembered. A failure never blocks the session. Only ② goes out into the context.
DIR=$(cd "$(dirname "$0")/.." && pwd)
python3 "$DIR/bin/_run.py" brain.tail notice "$@" 2>/dev/null || true
exit 0
